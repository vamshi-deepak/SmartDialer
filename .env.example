# SmartDialer Configuration

# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Storage Mode: 'in-memory' (default for fast deterministic simulation) or 'mongodb'
STORAGE_MODE=in-memory
MONGODB_URI=mongodb://localhost:27017/smartdialer

# Telecom Provider Settings
DEFAULT_PROVIDER=reliable # 'reliable' or 'unreliable'
PROVIDER_TIMEOUT_MS=5000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=15000

# Safety Controller Defaults
GLOBAL_MAX_CONCURRENT_CALLS=100
MAX_CALLS_PER_AGENT=1
RESERVATION_LEASE_TTL_SECONDS=15
ORPHAN_RECONCILIATION_INTERVAL_SECONDS=10
MAX_ACCEPTABLE_ABANDONMENT_RATE=0.03

# Local synthetic demo pool; these do not change safety limits.
DEMO_AGENT_COUNT=25
DEMO_BORROWER_COUNT=100

# Mock lifecycle timing in milliseconds. Calls remain active until simulated talk duration elapses.
MOCK_RINGING_DELAY_MS=100
MOCK_ANSWERED_DELAY_MS=500
MOCK_CONNECTED_DELAY_MS=750
MOCK_TALK_DURATION_MS=15000